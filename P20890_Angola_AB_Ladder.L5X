          <Routine Name="Vote_1" Type="RLL">
            <Description><![CDATA[Gas & Flame Detector Voting Matrix (1ooN, 2ooN, 1oo3, 2oo3)]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Clear CH4 Gas Low and High Detector Voting Accumulators]]></Comment>
                <Text><![CDATA[MOV(0,Vote_Gas_Lo_Count)MOV(0,Vote_Gas_Hi_Count);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Count Low Gas on DG-001..DG-004]]></Comment>
                <Text><![CDATA[XIC(R00115_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00135_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00155_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00175_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Count Low Gas on DG-005..DG-008]]></Comment>
                <Text><![CDATA[XIC(R00195_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00215_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00235_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00255_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Count Low Gas on DG-009..DG-012 and Open Path DG-011R]]></Comment>
                <Text><![CDATA[XIC(R00275_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00295_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00315_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00395_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count)XIC(R00375_6)ADD(Vote_Gas_Lo_Count,1,Vote_Gas_Lo_Count);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Count High Gas on DG-001..DG-004]]></Comment>
                <Text><![CDATA[XIC(R00115_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00135_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00155_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00175_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Count High Gas on DG-005..DG-008]]></Comment>
                <Text><![CDATA[XIC(R00195_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00215_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00235_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00255_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Count High Gas on DG-009..DG-012 and Open Path DG-011R]]></Comment>
                <Text><![CDATA[XIC(R00275_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00295_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00315_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00395_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count)XIC(R00375_5)ADD(Vote_Gas_Hi_Count,1,Vote_Gas_Hi_Count);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[1ooN Low Gas Voting Output (R01500_0: >= 1 Detector at 20% LEL)]]></Comment>
                <Text><![CDATA[GEQ(Vote_Gas_Lo_Count,1)OTE(R01500_0);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[2ooN Low Gas Voting Output (R01500_1: >= 2 Detectors at 20% LEL)]]></Comment>
                <Text><![CDATA[GEQ(Vote_Gas_Lo_Count,2)OTE(R01500_1);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[1ooN High Gas Voting Output (R01500_2: >= 1 Detector at 30% LEL)]]></Comment>
                <Text><![CDATA[GEQ(Vote_Gas_Hi_Count,1)OTE(R01500_2);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment><![CDATA[2ooN High Gas Voting Output (R01500_3: >= 2 Detectors at 30% LEL or Open Path High)]]></Comment>
                <Text><![CDATA[[GEQ(Vote_Gas_Hi_Count,2),XIC(R00375_5)]OTE(R01500_3);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment><![CDATA[Count Active Flame Detectors 7404-DF-001, 7404-DF-002, 7404-DF-003]]></Comment>
                <Text><![CDATA[MOV(0,Vote_Flame_Count)XIC(R00335_5)ADD(Vote_Flame_Count,1,Vote_Flame_Count)XIC(R00355_5)ADD(Vote_Flame_Count,1,Vote_Flame_Count)XIC(DF_7404_003_Latch)ADD(Vote_Flame_Count,1,Vote_Flame_Count);]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment><![CDATA[1oo3 Flame Alarm Voting (R01501_0: >= 1 Flame Detector Active)]]></Comment>
                <Text><![CDATA[GEQ(Vote_Flame_Count,1)OTE(R01501_0);]]></Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Comment><![CDATA[2oo3 Confirmed Flame Voting (R01501_1: >= 2 Flame Detectors Active)]]></Comment>
                <Text><![CDATA[GEQ(Vote_Flame_Count,2)OTE(R01501_1);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Logic" Type="RLL">
            <Description><![CDATA[Deluge Firewater/Foam Pump A & Standby Pump B Sequencing]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Deluge / Foam Release Demand: Triggered by Flame Alarm or Foam MACs (FR-001..003) unless inhibited by S2/S3 or stopped]]></Comment>
                <Text><![CDATA[[XIC(R01501_0),XIC(R00495_5),XIC(R00535_5)]XIO(R00708_0)XIO(R00709_0)XIO(R00701_0)OTE(Foam_Release_Demand);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Duty Deluge Pump A Run Command (PUMP_A / R01512_0) Start on Demand]]></Comment>
                <Text><![CDATA[XIC(Foam_Release_Demand)XIO(R00704_1)OTL(R01512_0);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Stop Duty Deluge Pump A on Foam Stop Button (E8 / FS-001) or System Reset]]></Comment>
                <Text><![CDATA[[XIC(R00701_0),XIC(M00002_System_Reset)]OTU(R01512_0);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Deluge Header Pressure Proving Timer (10.0s for 7503-PST-001 to reach 50 Psi)]]></Comment>
                <Text><![CDATA[XIC(Foam_Release_Demand)XIO(R00475_3)TON(TMR_PumpA_FailToRun,?,?);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Standby Diesel Pump B Demand: Auto-backup if Pump A fails to reach 50 Psi in 10s or Pump A wire fault]]></Comment>
                <Text><![CDATA[XIC(Foam_Release_Demand)[XIC(TMR_PumpA_FailToRun.DN),XIC(R00704_1)]XIO(R00706_0)XIO(R00703_0)OTE(Pump_B_Demand);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Standby Pump B Start Crank Pulse Output (PUMP_B_START / R01512_5)]]></Comment>
                <Text><![CDATA[XIC(Pump_B_Demand)XIO(R00475_3)OTE(R01512_5);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Standby Pump B Stop Pulse Output (PUMP_B_STOP / R01512_4) on Foam Stop Button]]></Comment>
                <Text><![CDATA[XIC(R00701_0)OTE(R01512_4);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="CE_LOG" Type="RLL">
            <Description><![CDATA[Cause & Effect Matrix Orchestrator (01-MAN-03-07)]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Execute Panel Indicators Subroutine (Indicat)]]></Comment>
                <Text><![CDATA[JSR(Indicat,0);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Execute Master Shutdown Subroutine (Shutdow)]]></Comment>
                <Text><![CDATA[JSR(Shutdow,0);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Execute Foam/Deluge Protection Status Subroutine (Protect)]]></Comment>
                <Text><![CDATA[JSR(Protect,0);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Execute Audible & Visual Alarm Mode Subroutine (Loc_Al)]]></Comment>
                <Text><![CDATA[JSR(Loc_Al,0);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Execute System Fault Aggregator Subroutine (FLT_1)]]></Comment>
                <Text><![CDATA[JSR(FLT_1,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Indicat" Type="RLL">
            <Description><![CDATA[FGCP-7404-001 Panel LEDs & Individual Pump Relay Indicators]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[L15 (Local:8:O.Data.12): ESDV Fuel Gas Line Open Green LED]]></Comment>
                <Text><![CDATA[XIC(R00700_0)OTE(R01513_0);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[L14 (Local:8:O.Data.11): ESDV Fuel Gas Line Closed Red LED]]></Comment>
                <Text><![CDATA[XIC(R00700_1)OTE(R01513_1);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[L16 (Local:8:O.Data.13): ESDV Low Air Accumulator Supply Amber LED]]></Comment>
                <Text><![CDATA[XIC(R00435_6)OTE(R01513_2);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[L17 (Local:8:O.Data.14): Low Fuel Gas Line Pressure Amber LED]]></Comment>
                <Text><![CDATA[XIC(R00455_6)OTE(LED_Low_Fuel_Gas_L17);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[CR1 (Local:8:O.Data.15): Trip Power Oil Pump P-2300 (E1, ESD Trip, or PIT-003 PAHH 2800 Psi)]]></Comment>
                <Text><![CDATA[[XIC(Latch_ESTOP_P2300),XIO(R01510_0),XIC(PIT_003_PAHH_Latch)]XIO(R00709_0)OTE(CR1_P2300_Stop);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[CR2 (Local:8:O.Data.16): Trip Power Oil Pump P-2400 (E2, ESD Trip, or PIT-003 PAHH 2800 Psi)]]></Comment>
                <Text><![CDATA[[XIC(Latch_ESTOP_P2400),XIO(R01510_0),XIC(PIT_003_PAHH_Latch)]XIO(R00709_0)OTE(CR2_P2400_Stop);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[CR3 (Local:8:O.Data.17): Trip Power Oil Pump P-2500 (E3, ESD Trip, or PIT-003 PAHH 2800 Psi)]]></Comment>
                <Text><![CDATA[[XIC(Latch_ESTOP_P2500),XIO(R01510_0),XIC(PIT_003_PAHH_Latch)]XIO(R00709_0)OTE(CR3_P2500_Stop);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[CR4 (Local:8:O.Data.18): Trip Power Oil Pump P-2600 (E4, ESD Trip, or PIT-003 PAHH 2800 Psi)]]></Comment>
                <Text><![CDATA[[XIC(Latch_ESTOP_P2600),XIO(R01510_0),XIC(PIT_003_PAHH_Latch)]XIO(R00709_0)OTE(CR4_P2600_Stop);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[CR5 (Local:8:O.Data.19): Trip Water Injection Pump P-3800 (E5, ESD Trip, or PIT-002 PAHH 900 Psi)]]></Comment>
                <Text><![CDATA[[XIC(Latch_ESTOP_P3800),XIO(R01510_0),XIC(PIT_002_PAHH_Latch)]XIO(R00709_0)OTE(CR5_P3800_Stop);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[CR6 (Local:8:O.Data.20): Trip Water Injection Pump P-3900 (E6, ESD Trip, or PIT-002 PAHH 900 Psi)]]></Comment>
                <Text><![CDATA[[XIC(Latch_ESTOP_P3900),XIO(R01510_0),XIC(PIT_002_PAHH_Latch)]XIO(R00709_0)OTE(CR6_P3900_Stop);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Shutdow" Type="RLL">
            <Description><![CDATA[Master Emergency Shutdown Matrix (Fail-Safe Logic)]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Master Station ESD Trip Condition: High Gas 30%, Flame >=30%, Foam MAC, Deluge >=50 Psi, Fuel Gas >=100 Psi]]></Comment>
                <Text><![CDATA[[XIC(R01500_2),XIC(R01500_3),XIC(R01501_0),XIC(R00495_5),XIC(R00535_5),XIC(R00475_5),XIC(R00455_5)]XIO(R00709_0)OTE(ESD_Trip_Condition);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[PumpShutdown (Local:8:O.Data.0): Fail-Safe Energize-to-Run (1=Healthy, 0=Station ESD Trip)]]></Comment>
                <Text><![CDATA[XIO(ESD_Trip_Condition)OTE(R01510_0);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[6401-EY-001/002 ESDV Solenoid (Local:8:O.Data.1): Fail-Safe Energize-to-Open (Tripped by ESD or E9)]]></Comment>
                <Text><![CDATA[XIO(ESD_Trip_Condition)[XIO(R00707_1),XIC(R00709_0)]OTE(R01511_0);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[P-2100/2200 Oil Booster Pump Shutdown Relay (Local:8:O.Data.8): Tripped by ESD or PIT-003 PAHH 2800 Psi]]></Comment>
                <Text><![CDATA[XIO(ESD_Trip_Condition)[XIO(PIT_003_PAHH_Latch),XIC(R00709_0)]OTE(R01511_1);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[P-3600/3700 Water Booster Pump Shutdown Relay (Local:8:O.Data.9): Tripped by ESD or PIT-002 PAHH 900 Psi]]></Comment>
                <Text><![CDATA[XIO(ESD_Trip_Condition)[XIO(PIT_002_PAHH_Latch),XIC(R00709_0)]OTE(R01511_2);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[SD-GE (Local:8:O.Data.21): Shut Down All Gas Generators (GD-001..003 >= 30%, Smoke >= 30%, or Station ESD)]]></Comment>
                <Text><![CDATA[[XIC(GD_Any_Hi_Latch),XIC(SD_001_002_Latch),XIC(ESD_Trip_Condition)]XIO(R00709_0)OTE(SD_GE);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Protect" Type="RLL">
            <Description><![CDATA[Firewater & Foam Deluge Protection System Status]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Deluge Released Confirmation Status (7503-PST-001 >= 50 Psi)]]></Comment>
                <Text><![CDATA[XIC(R00475_5)OTE(Deluge_Released_Status);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Foam System Inhibited Status (Keyswitch S2 or S3 active)]]></Comment>
                <Text><![CDATA[[XIC(R00708_0),XIC(R00709_0)]OTE(Foam_System_Inhibited);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Loc_Al" Type="RLL">
            <Description><![CDATA[Audible & Visual Alarm Pattern Selection (Z1, PA-001, H2SA, SDA)]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Pump House Bell Discontinuous Mode (1ooN Low Gas 20% LEL or Open Path 1.00 LELm)]]></Comment>
                <Text><![CDATA[XIC(R01500_0)XIO(R01500_2)XIO(R01501_0)XIO(R00495_5)XIO(R00535_5)XIO(R00475_5)OTE(Bell_Mode_Discontinuous);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Pump House Bell Continuous Mode (High Gas 30%, Flame >=30%, Foam MAC, Deluge Released)]]></Comment>
                <Text><![CDATA[[XIC(R01500_2),XIC(R01501_0),XIC(R00495_5),XIC(R00535_5),XIC(R00475_5)]OTE(Bell_Mode_Continuous);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Aggregate Any Unaccepted Plant Alarm Condition]]></Comment>
                <Text><![CDATA[[XIC(R01500_0),XIC(R01500_2),XIC(R01501_0),XIC(R00495_5),XIC(R00535_5),XIC(R00475_5),XIC(R00435_6),XIC(R00455_5),XIC(R00455_6),XIC(R00707_1),XIC(GD_Any_Lo_Latch),XIC(GD_Any_Hi_Latch),XIC(H2S_Lo_Latch),XIC(H2S_Hi_Latch),XIC(SD_001_002_Latch),XIC(PIT_001_PAL),XIC(PIT_001_PAH),XIC(PIT_002_PAL),XIC(PIT_002_PAH),XIC(PIT_002_PAHH_Latch),XIC(PIT_003_PAL),XIC(PIT_003_PAH),XIC(PIT_003_PAHH_Latch),XIC(LIT_100_LAL),XIC(LIT_100_LAH),XIC(LIT_200_LAL),XIC(LIT_200_LAH),XIC(LIT_300_LAL),XIC(LIT_300_LAH),XIC(LIT_400_LAL),XIC(LIT_400_LAH),XIC(FT_6401_001_FAL),XIC(FT_6401_001_FAH)]OTE(Any_Unaccepted_Alarm);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Silence / Acknowledge Alarm Latch via E12 Mute Pushbutton or HMI M00001]]></Comment>
                <Text><![CDATA[XIC(M00001_System_Accept)OTL(Alarm_Silence_Latch);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Reset Alarm Silence Latch when all alarms clear or System Reset]]></Comment>
                <Text><![CDATA[[XIO(Any_Unaccepted_Alarm),XIC(M00002_System_Reset)]OTU(Alarm_Silence_Latch);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Z1 (Local:8:O.Data.22): Production Control Room Audible Alarm Horn]]></Comment>
                <Text><![CDATA[XIC(Any_Unaccepted_Alarm)XIO(Alarm_Silence_Latch)OTE(R01513_3);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[PA-001 (Local:8:O.Data.23): Process Production Building Audible Alarm]]></Comment>
                <Text><![CDATA[[XIC(PIT_001_PAL),XIC(PIT_001_PAH),XIC(PIT_002_PAL),XIC(PIT_002_PAH),XIC(PIT_002_PAHH_Latch),XIC(PIT_003_PAL),XIC(PIT_003_PAH),XIC(PIT_003_PAHH_Latch),XIC(LIT_100_LAL),XIC(LIT_100_LAH),XIC(LIT_200_LAL),XIC(LIT_200_LAH),XIC(LIT_300_LAL),XIC(LIT_300_LAH),XIC(LIT_400_LAL),XIC(LIT_400_LAH),XIC(FT_6401_001_FAL),XIC(FT_6401_001_FAH),XIC(R00435_6),XIC(R00455_5),XIC(R00455_6)]XIO(Alarm_Silence_Latch)XIO(R00709_0)OTE(PA_001);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[H2SA-001/002 (Local:8:O.Data.30): Toxic H2S Gas Horn & Strobe Beacon (Pulsing 1Hz on Low, Continuous on High)]]></Comment>
                <Text><![CDATA[[XIC(H2S_Hi_Latch),[XIC(H2S_Lo_Latch),XIC(R01598_0)]]XIO(Alarm_Silence_Latch)XIO(R00709_0)OTE(H2SA_001_002);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[SDA-001 (Local:8:O.Data.31): Smoke Detection Horn & Strobe Beacon]]></Comment>
                <Text><![CDATA[XIC(SD_001_002_Latch)XIO(Alarm_Silence_Latch)XIO(R00709_0)OTE(SDA_001);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="FLT_1" Type="RLL">
            <Description><![CDATA[System, I/O Module & Transmitter Fault Aggregation (PLC_Fault)]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Aggregate All Transmitter Wire Breaks, Optical Beam Block, ESDV Discrepancy & Line Faults]]></Comment>
                <Text><![CDATA[[XIC(R00115_2),XIC(R00135_2),XIC(R00155_2),XIC(R00175_2),XIC(R00195_2),XIC(R00215_2),XIC(R00235_2),XIC(R00255_2),XIC(R00275_2),XIC(R00295_2),XIC(R00315_2),XIC(R00335_2),XIC(R00355_2),XIC(R00375_2),XIC(R00395_2),XIC(R00435_2),XIC(R00455_2),XIC(R00475_2),XIC(R00495_2),XIC(R00535_2),XIC(GD_001_Fault),XIC(GD_002_Fault),XIC(GD_003_Fault),XIC(PIT_001_Fault),XIC(PIT_002_Fault),XIC(PIT_003_Fault),XIC(DF_7404_003_Fault),XIC(SD_001_002_Fault),XIC(R00700_6),XIC(R00704_1),XIC(R00705_1)]OTE(Any_Channel_Fault);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[PLC_Fault (Local:8:O.Data.10): Fail-Safe System Healthy Output (1=No Fault, 0=Fault Present)]]></Comment>
                <Text><![CDATA[XIO(Any_Channel_Fault)OTE(R01513_4);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Sound" Type="RLL">
            <Description><![CDATA[7404-SA-001/002 Pump House Alarm Bell Driver]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[7404-SA-001/002 (Local:8:O.Data.2): Drive Pump House Bell Continuous or Discontinuous (0.8s Flasher R01598_0)]]></Comment>
                <Text><![CDATA[[XIC(Bell_Mode_Continuous),[XIC(Bell_Mode_Discontinuous),XIC(R01598_0)]]XIO(Alarm_Silence_Latch)XIO(R00708_0)XIO(R00709_0)OTE(R01511_3);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Output" Type="RLL">
            <Description><![CDATA[Slot 8 1756-OB32 Discrete Hardware Output Driver Mapping]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Point 0: PumpShutdown (Local:8:O.Data.0) Master ESD Trip Relay (Fail-Safe 1=Run)]]></Comment>
                <Text><![CDATA[XIC(R01510_0)[OTE(PumpShutdown),OTE(Local:8:O.Data.0)];]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Point 1: 6401-EY-001/002 (Local:8:O.Data.1) Fuel Gas ESDV Solenoid (Fail-Safe 1=Open)]]></Comment>
                <Text><![CDATA[XIC(R01511_0)[OTE(EY_6401_001_002),OTE(Local:8:O.Data.1)];]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Point 2: 7404-SA-001/002 (Local:8:O.Data.2) Local Alarm Bell Pump House]]></Comment>
                <Text><![CDATA[XIC(R01511_3)[OTE(SA_7404_001_002),OTE(Local:8:O.Data.2)];]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Point 3: Pump_A_PulsOut (Local:8:O.Data.3) Deluge Pump A Pulse Line Check]]></Comment>
                <Text><![CDATA[XIC(R01513_12)[OTE(Pump_A_PulsOut),OTE(Local:8:O.Data.3)];]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Point 4: PUMP_A (Local:8:O.Data.4) Deluge Duty Firewater Pump A Run Output]]></Comment>
                <Text><![CDATA[XIC(R01512_0)[OTE(PUMP_A),OTE(Local:8:O.Data.4)];]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Point 5: Pump_B_Start_PulsOut (Local:8:O.Data.5) Deluge Pump B Pulse Line Check]]></Comment>
                <Text><![CDATA[XIC(R01513_13)[OTE(Pump_B_Start_PulsOut),OTE(Local:8:O.Data.5)];]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Point 6: PUMP_B_START (Local:8:O.Data.6) Deluge Standby Diesel Pump B Start Pulse]]></Comment>
                <Text><![CDATA[XIC(R01512_5)[OTE(PUMP_B_START),OTE(Local:8:O.Data.6)];]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[Point 7: PUMP_B_STOP (Local:8:O.Data.7) Deluge Standby Diesel Pump B Stop Pulse]]></Comment>
                <Text><![CDATA[XIC(R01512_4)[OTE(PUMP_B_STOP),OTE(Local:8:O.Data.7)];]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[Point 8: P2100_P2200 (Local:8:O.Data.8) Oil Booster Pump Shutdown Relay (Fail-Safe 1=Run)]]></Comment>
                <Text><![CDATA[XIC(R01511_1)[OTE(P2100_P2200),OTE(Local:8:O.Data.8)];]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[Point 9: P3600_P3700 (Local:8:O.Data.9) Water Booster Pump Shutdown Relay (Fail-Safe 1=Run)]]></Comment>
                <Text><![CDATA[XIC(R01511_2)[OTE(P3600_P3700),OTE(Local:8:O.Data.9)];]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment><![CDATA[Point 10: PLC_Fault (Local:8:O.Data.10) PLC / System Fault Contact (Fail-Safe 1=Healthy)]]></Comment>
                <Text><![CDATA[XIC(R01513_4)[OTE(PLC_Fault),OTE(Local:8:O.Data.10)];]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment><![CDATA[Point 11: Tag_DO_13 / L14 (Local:8:O.Data.11) ESDV Fuel Gas Closed Red LED Indicator]]></Comment>
                <Text><![CDATA[XIC(R01513_1)[OTE(Tag_DO_13),OTE(Local:8:O.Data.11)];]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment><![CDATA[Point 12: Tag_DO_12 / L15 (Local:8:O.Data.12) ESDV Fuel Gas Open Green LED Indicator]]></Comment>
                <Text><![CDATA[XIC(R01513_0)[OTE(Tag_DO_12),OTE(Local:8:O.Data.12)];]]></Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Comment><![CDATA[Point 13: Tag_DO_14 / L16 (Local:8:O.Data.13) ESDV Low Air Accumulator Supply Amber LED]]></Comment>
                <Text><![CDATA[XIC(R01513_2)[OTE(Tag_DO_14),OTE(Local:8:O.Data.13)];]]></Text>
