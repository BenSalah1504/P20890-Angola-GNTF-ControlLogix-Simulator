              </Rung>
              <Rung Number="23" Type="N">
                <Comment><![CDATA[Rung 23: 7404-SB-008 (E5) E-Stop Water Injection Pump P-3800 Latch]]></Comment>
                <Text><![CDATA[XIC(ESTOP_P3800_E5)OTL(Latch_ESTOP_P3800);]]></Text>
              </Rung>
