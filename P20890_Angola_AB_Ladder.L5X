          <Routine Name="DI_1" Type="RLL">
            <Description><![CDATA[Digital Input Conditioning & ESD Valve Discrepancy Timers]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Rung 0: 6401-ZSH-001 Valve Open Limit Switch Condition]]></Comment>
                <Text><![CDATA[XIC(G0001)OTE(R00700_0);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Rung 1: 6401-ZSL-001 Valve Closed Limit Switch Condition]]></Comment>
                <Text><![CDATA[XIC(G0002)OTE(R00700_1);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Rung 2: ESDV Switch Conflict (Both Open and Closed Active Simultaneously)]]></Comment>
                <Text><![CDATA[XIC(R00700_0)XIC(R00700_1)OTE(R00700_2);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Rung 3: ESDV Transit Timer (Valve in Transit Neither Open Nor Closed > 10.0s)]]></Comment>
                <Text><![CDATA[XIO(R00700_0)XIO(R00700_1)TON(TMR_ESDV_Transit,?,?);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Rung 4: ESDV Transit Fault Latch]]></Comment>
                <Text><![CDATA[XIC(TMR_ESDV_Transit.DN)OTE(R00700_3);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Rung 5: ESDV Commanded Open (EY Energized) but Not Open within 10.0s]]></Comment>
                <Text><![CDATA[XIC(R01511_0)XIO(R00700_0)TON(TMR_ESDV_CmdOpen,?,?);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Rung 6: ESDV Fail to Open Fault Flag]]></Comment>
                <Text><![CDATA[XIC(TMR_ESDV_CmdOpen.DN)OTE(R00700_4);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[Rung 7: ESDV Commanded Closed (EY De-energized) but Not Closed within 10.0s]]></Comment>
                <Text><![CDATA[XIO(R01511_0)XIO(R00700_1)TON(TMR_ESDV_CmdClose,?,?);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[Rung 8: ESDV Fail to Close Fault Flag]]></Comment>
                <Text><![CDATA[XIC(TMR_ESDV_CmdClose.DN)OTE(R00700_5);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[Rung 9: Consolidated ESDV Position Discrepancy Latch (R00700_6)]]></Comment>
                <Text><![CDATA[[XIC(R00700_2),XIC(R00700_3),XIC(R00700_4),XIC(R00700_5)]OTL(R00700_6);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment><![CDATA[Rung 10: Reset ESDV Discrepancy Latch on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)OTU(R00700_6);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment><![CDATA[Rung 11: 7503-FS-001 Field Stop Foam (NC) or E8 Panel Stop Foam (NO)]]></Comment>
                <Text><![CDATA[[XIO(G0003),XIC(G0008)][OTE(R00701_0),OTL(R00701_1)];]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment><![CDATA[Rung 12: Reset Foam Stop Latch on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)XIC(G0003)XIO(G0008)OTU(R00701_1);]]></Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Comment><![CDATA[Rung 13: 7503-LS-001 AFFF Foam Concentrate Tank Low Level Switch (NC: 0=Low)]]></Comment>
                <Text><![CDATA[XIO(G0004)[OTE(R00702_0),OTL(R00702_1)];]]></Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Comment><![CDATA[Rung 14: Reset Foam Tank Low Level Latch on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)XIC(G0004)OTU(R00702_1);]]></Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Comment><![CDATA[Rung 15: 7503-LS-002 Diesel Fuel Tank Low Level Switch (NC: 0=Low)]]></Comment>
                <Text><![CDATA[XIO(G0005)[OTE(R00703_0),OTL(R00703_1)];]]></Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Comment><![CDATA[Rung 16: Reset Diesel Tank Low Level Latch on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)XIC(G0005)OTU(R00703_1);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="DI_2" Type="RLL">
            <Description><![CDATA[Deluge Coil Continuity Pulse Monitoring, Keyswitches & E-Stops]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Rung 0: 60-Second Periodic Timer for Deluge Coil Continuity Pulse Test]]></Comment>
                <Text><![CDATA[XIO(TMR_Pulse_Width.DN)TON(TMR_Pulse_Period,?,?);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Rung 1: 1.0-Second Pulse Width Timer for Deluge Coil Line Check]]></Comment>
                <Text><![CDATA[XIC(TMR_Pulse_Period.DN)TON(TMR_Pulse_Width,?,?);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Rung 2: Generate Pulse Test Output for Deluge Pump A (Pump_A_PulsOut)]]></Comment>
                <Text><![CDATA[XIC(TMR_Pulse_Period.DN)XIO(R01512_0)OTE(R01513_12);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Rung 3: Generate Pulse Test Output for Deluge Pump B (Pump_B_Start_PulsOut)]]></Comment>
                <Text><![CDATA[XIC(TMR_Pulse_Period.DN)XIO(R01512_5)OTE(R01513_13);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Rung 4: Deluge Pump A Line Check Discrepancy Timer (500ms without feedback)]]></Comment>
                <Text><![CDATA[XIC(R01513_12)XIO(G0006)TON(TMR_PumpA_WireFlt,?,?);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Rung 5: Deluge Pump A Coil Open-Circuit Fault Latch (R00704_1)]]></Comment>
                <Text><![CDATA[XIC(TMR_PumpA_WireFlt.DN)OTL(R00704_1);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Rung 6: Reset Pump A Open-Circuit Fault on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)OTU(R00704_1);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[Rung 7: Deluge Pump B Line Check Discrepancy Timer (500ms without feedback)]]></Comment>
                <Text><![CDATA[XIC(R01513_13)XIO(G0007)TON(TMR_PumpB_WireFlt,?,?);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[Rung 8: Deluge Pump B Coil Open-Circuit Fault Latch (R00705_1)]]></Comment>
                <Text><![CDATA[XIC(TMR_PumpB_WireFlt.DN)OTL(R00705_1);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[Rung 9: Reset Pump B Open-Circuit Fault on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)OTU(R00705_1);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment><![CDATA[Rung 10: 75-SB-01B Standby Diesel Pump B Inhibited Status]]></Comment>
                <Text><![CDATA[XIC(G0009)OTE(R00706_0);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment><![CDATA[Rung 11: 6401-ESDV-001 (E9) Station ESD Pushbutton Condition (NC: 0=Pressed)]]></Comment>
                <Text><![CDATA[XIO(G0010)[OTE(R00707_0),OTL(R00707_1)];]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment><![CDATA[Rung 12: Reset Station ESD Pushbutton Latch on System Reset]]></Comment>
                <Text><![CDATA[XIC(M00002_System_Reset)XIC(G0010)OTU(R00707_1);]]></Text>
