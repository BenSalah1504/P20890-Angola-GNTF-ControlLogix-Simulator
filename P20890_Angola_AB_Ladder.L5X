                <Text><![CDATA[XIC(G0012)OTE(R00708_0);]]></Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Comment><![CDATA[Rung 14: FGCP-7404-001 Keyswitch S3 (Inhibition All Outputs)]]></Comment>
                <Text><![CDATA[XIC(G0013)OTE(R00709_0);]]></Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Comment><![CDATA[Rung 15: 7404-SB-004 (E1) E-Stop Power Oil Pump P-2300 Latch]]></Comment>
                <Text><![CDATA[XIC(ESTOP_P2300_E1)OTL(Latch_ESTOP_P2300);]]></Text>
