                <Text><![CDATA[XIC(M00002_System_Reset)OTU(Latch_ESTOP_P2400);]]></Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Comment><![CDATA[Rung 19: 7404-SB-006 (E3) E-Stop Power Oil Pump P-2500 Latch]]></Comment>
                <Text><![CDATA[XIC(ESTOP_P2500_E3)OTL(Latch_ESTOP_P2500);]]></Text>
              </Rung>
              <Rung Number="20" Type="N">
