      </Tag>
      <Tag Name="SP_PIT002_PAHH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: PIT-002 High-High Trip (900.0 Psi)]]></Description>
      </Tag>
      <Tag Name="SP_PIT003_PAL" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: PIT-003 Low Pressure (1700.0 Psi)]]></Description>
      </Tag>
      <Tag Name="SP_PIT003_PAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: PIT-003 High Pressure (2700.0 Psi)]]></Description>
      </Tag>
      <Tag Name="SP_PIT003_PAHH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: PIT-003 High-High Trip (2800.0 Psi)]]></Description>
      </Tag>
      <Tag Name="SP_LIT100_LAL" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-100 Low Level (0.7 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT100_LAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-100 High Level (9.0 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT200_LAL" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-200 Low Level (0.7 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT200_LAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-200 High Level (9.0 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT300_LAL" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-300 Low Level (0.7 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT300_LAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-300 High Level (9.0 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT400_LAL" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-400 Low Level (0.7 m)]]></Description>
      </Tag>
      <Tag Name="SP_LIT400_LAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: LIT-400 High Level (11.0 m)]]></Description>
      </Tag>
      <Tag Name="SP_FT001_FAL" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: 6401-FT-001 Low Flow (30.0 bbl/h)]]></Description>
      </Tag>
      <Tag Name="SP_FT001_FAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Setpoint: 6401-FT-001 High Flow (300.0 bbl/h)]]></Description>
      </Tag>
      <Tag Name="TMR_Flash_Slow" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[0.4s Slow Flasher Timer]]></Description>
      </Tag>
      <Tag Name="TMR_Flash_Fast" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[0.4s Fast Flasher Timer]]></Description>
      </Tag>
      <Tag Name="TMR_ESDV_Transit" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[10.0s ESDV Transit Discrepancy Timer]]></Description>
      </Tag>
      <Tag Name="TMR_ESDV_CmdOpen" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[10.0s ESDV Commanded Open Discrepancy Timer]]></Description>
      </Tag>
      <Tag Name="TMR_ESDV_CmdClose" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[10.0s ESDV Commanded Closed Discrepancy Timer]]></Description>
      </Tag>
      <Tag Name="TMR_Pulse_Period" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[60.0s Deluge Pump Line Continuity Check Period Timer]]></Description>
      </Tag>
      <Tag Name="TMR_Pulse_Width" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[1.0s Deluge Pump Line Continuity Test Pulse Timer]]></Description>
      </Tag>
      <Tag Name="TMR_PumpA_WireFlt" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[0.5s Deluge Pump A Open-Circuit Fault Timer]]></Description>
      </Tag>
      <Tag Name="TMR_PumpB_WireFlt" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[0.5s Deluge Pump B Open-Circuit Fault Timer]]></Description>
      </Tag>
      <Tag Name="TMR_PumpA_FailToRun" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[10.0s Deluge Pump A Pressure Proving Timer]]></Description>
      </Tag>
      <Tag Name="TMR_PumpB_StartOn" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[2.0s Standby Pump B Crank ON Timer]]></Description>
      </Tag>
      <Tag Name="TMR_PumpB_StartOff" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[2.0s Standby Pump B Crank Rest OFF Timer]]></Description>
      </Tag>
      <Tag Name="TMR_PumpB_StopPulse" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[2.0s Standby Pump B Stop Pulse Timer]]></Description>
      </Tag>
      <Tag Name="CTU_PumpB_Attempts" TagType="Base" DataType="FBD_COUNTER" Constant="false" ExternalAccess="Read/Write">
        <Description><![CDATA[Standby Pump B Start Attempt Counter (3 Attempts)]]></Description>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
        <Description><![CDATA[FGCP-7404-001 Fire, Gas, ESD & Process Control Program (Relay Ladder Logic)]]></Description>
        <Tags/>
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <Description><![CDATA[Main Executive Cycle & Subroutine Scheduler]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Rung 0: 400ms Free-Running Flasher Slow Timer (TMR_Flash_Slow)]]></Comment>
                <Text><![CDATA[XIO(TMR_Flash_Fast.DN)TON(TMR_Flash_Slow,?,?);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Rung 1: 400ms Flasher Reset Timer (TMR_Flash_Fast)]]></Comment>
                <Text><![CDATA[XIC(TMR_Flash_Slow.DN)TON(TMR_Flash_Fast,?,?);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Rung 2: Toggle 0.4s Flasher Bit (R01598_0) on Slow Timer Done]]></Comment>
                <Text><![CDATA[XIC(TMR_Flash_Slow.DN)XIO(R01598_1)[XIC(R01598_0)OTU(R01598_0),XIO(R01598_0)OTL(R01598_0)];]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Rung 3: Flasher One-Shot Follower Bit (R01598_1)]]></Comment>
                <Text><![CDATA[XIC(TMR_Flash_Slow.DN)OTE(R01598_1);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Rung 4: Secondary Toggle Divider Bit (R01598_2)]]></Comment>
                <Text><![CDATA[XIC(R01598_0)XIO(R01598_3)[XIC(R01598_2)OTU(R01598_2),XIO(R01598_2)OTL(R01598_2)];]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Rung 5: Secondary Follower Bit (R01598_3)]]></Comment>
                <Text><![CDATA[XIC(R01598_0)OTE(R01598_3);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Rung 6: Tertiary Toggle Divider Bit (R01598_4)]]></Comment>
                <Text><![CDATA[XIC(R01598_2)XIO(R01598_5)[XIC(R01598_4)OTU(R01598_4),XIO(R01598_4)OTL(R01598_4)];]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[Rung 7: Tertiary Follower Bit (R01598_5)]]></Comment>
                <Text><![CDATA[XIC(R01598_2)OTE(R01598_5);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[Rung 8: First Scan Initialization Subroutine Call (Init)]]></Comment>
                <Text><![CDATA[XIC(S:FS)JSR(Init,0);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[Rung 9: Hardware Digital & Analog Input Processing Subroutine Calls]]></Comment>
                <Text><![CDATA[JSR(Input,0)JSR(DI_1,0)JSR(DI_2,0)JSR(AI_1,0)JSR(AI_2,0)JSR(AI_3,0)JSR(AI_4_New,0);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment><![CDATA[Rung 10: Analog Alarm Evaluation & F&G Detector Voting Subroutines]]></Comment>
                <Text><![CDATA[JSR(Ai_AL_1,0)JSR(Ai_AL_2,0)JSR(Ai_AL_3,0)JSR(Vote_1,0);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment><![CDATA[Rung 11: Control Logic, Cause & Effect Matrix & Hardware Output Drivers]]></Comment>
                <Text><![CDATA[JSR(Logic,0)JSR(CE_LOG,0)JSR(Sound,0)JSR(Output,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Init" Type="RLL">
            <Description><![CDATA[Setpoint & Engineering Range Calibration Initialization]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-001 CH4 Gas Detector 1: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00101)MOV(100.0,R00103)MOV(105.0,R00105)MOV(-4.0,R00107)MOV(30.0,R00109)MOV(20.0,R00111);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-002 CH4 Gas Detector 2: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00121)MOV(100.0,R00123)MOV(105.0,R00125)MOV(-4.0,R00127)MOV(30.0,R00129)MOV(20.0,R00131);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-003 CH4 Gas Detector 3: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00141)MOV(100.0,R00143)MOV(105.0,R00145)MOV(-4.0,R00147)MOV(30.0,R00149)MOV(20.0,R00151);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-004 CH4 Gas Detector 4: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00161)MOV(100.0,R00163)MOV(105.0,R00165)MOV(-4.0,R00167)MOV(30.0,R00169)MOV(20.0,R00171);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-005 CH4 Gas Detector 5: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00181)MOV(100.0,R00183)MOV(105.0,R00185)MOV(-4.0,R00187)MOV(30.0,R00189)MOV(20.0,R00191);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-006 CH4 Gas Detector 6: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00201)MOV(100.0,R00203)MOV(105.0,R00205)MOV(-4.0,R00207)MOV(30.0,R00209)MOV(20.0,R00211);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-007 CH4 Gas Detector 7: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00221)MOV(100.0,R00223)MOV(105.0,R00225)MOV(-4.0,R00227)MOV(30.0,R00229)MOV(20.0,R00231);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-008 CH4 Gas Detector 8: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00241)MOV(100.0,R00243)MOV(105.0,R00245)MOV(-4.0,R00247)MOV(30.0,R00249)MOV(20.0,R00251);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-009 CH4 Gas Detector 9: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00261)MOV(100.0,R00263)MOV(105.0,R00265)MOV(-4.0,R00267)MOV(30.0,R00269)MOV(20.0,R00271);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-010 CH4 Gas Detector 10: Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00281)MOV(100.0,R00283)MOV(105.0,R00285)MOV(-4.0,R00287)MOV(30.0,R00289)MOV(20.0,R00291);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-011 CH4 Gas Detector 11 (was SpareAI_11): Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00301)MOV(100.0,R00303)MOV(105.0,R00305)MOV(-4.0,R00307)MOV(30.0,R00309)MOV(20.0,R00311);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-012 CH4 Gas Detector 12 (was SpareAI_15): Zero=0%, Span=100%, HiFlt=105%, LoFlt=-4%, HiAlm=30%, LoAlm=20%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00381)MOV(100.0,R00383)MOV(105.0,R00385)MOV(-4.0,R00387)MOV(30.0,R00389)MOV(20.0,R00391);]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment><![CDATA[Initialize 7404-DF-001 Flame Detector 1: Zero=0%, Span=100%, Alarm=30%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00321)MOV(100.0,R00323)MOV(105.0,R00325)MOV(-4.0,R00327)MOV(30.0,R00329)MOV(101.0,R00331);]]></Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Comment><![CDATA[Initialize 7404-DF-002 Flame Detector 2: Zero=0%, Span=100%, Alarm=30%]]></Comment>
                <Text><![CDATA[MOV(0.0,R00341)MOV(100.0,R00343)MOV(105.0,R00345)MOV(-4.0,R00347)MOV(30.0,R00349)MOV(101.0,R00351);]]></Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Comment><![CDATA[Initialize 7404-DG-011R Open Path IR Gas Detector: 0-5.00 LELm, Lo=1.00, Hi=3.00, Optic Fault Window -0.78125 to -0.46875]]></Comment>
                <Text><![CDATA[MOV(0.0,R00361)MOV(5.00,R00363)MOV(5.10,R00365)MOV(-0.78125,R00367)MOV(3.00,R00369)MOV(1.00,R00371)MOV(-0.46875,R00581);]]></Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Comment><![CDATA[Initialize 7002-PST-001 Air Accumulator Pressure: 0-100 Psi, Low Alarm PAL=50 Psi (LED L16)]]></Comment>
                <Text><![CDATA[MOV(0.0,R00421)MOV(100.0,R00423)MOV(105.0,R00425)MOV(-4.0,R00427)MOV(-10.0,R00429)MOV(50.0,R00431);]]></Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Comment><![CDATA[Initialize 6401-PST-001 Fuel Gas Pressure: 0-150 Psi, PAL=40 Psi (LED L17), PAH=100 Psi (Station ESD)]]></Comment>
                <Text><![CDATA[MOV(0.0,R00441)MOV(150.0,R00443)MOV(155.0,R00445)MOV(-4.0,R00447)MOV(100.0,R00449)MOV(40.0,R00451);]]></Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Comment><![CDATA[Initialize 7503-PST-001 Deluge Line Pressure: 0-100 Psi, High Alarm PAH=50 Psi (Deluge Released)]]></Comment>
                <Text><![CDATA[MOV(0.0,R00461)MOV(100.0,R00463)MOV(102.0,R00465)MOV(-4.0,R00467)MOV(50.0,R00469)MOV(101.0,R00471);]]></Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Comment><![CDATA[Initialize 7503-FR-001/002 Outside Foam Release MAC Call Points (Alarm Threshold = 30%)]]></Comment>
                <Text><![CDATA[MOV(0.0,R00481)MOV(100.0,R00483)MOV(105.0,R00485)MOV(-4.0,R00487)MOV(30.0,R00489)MOV(101.0,R00491);]]></Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Comment><![CDATA[Initialize 7503-FR-003 Inside PCR Local CP Foam Release MAC Call Point (Alarm Threshold = 30%)]]></Comment>
                <Text><![CDATA[MOV(0.0,R00521)MOV(100.0,R00523)MOV(105.0,R00525)MOV(-4.0,R00527)MOV(30.0,R00529)MOV(101.0,R00531);]]></Text>
              </Rung>
              <Rung Number="20" Type="N">
                <Comment><![CDATA[Initialize GNTF Upgrade Setpoints: GD-001..003 (20%/30%), H2S-001..012 (10/20 PPM), DF-003 (30%), SD-001/002 (30%)]]></Comment>
                <Text><![CDATA[MOV(20.0,SP_GD_Low_LEL)MOV(30.0,SP_GD_High_LEL)MOV(10.0,SP_H2S_Low_PPM)MOV(20.0,SP_H2S_High_PPM)MOV(30.0,SP_DF003_High)MOV(30.0,SP_SD_High);]]></Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Comment><![CDATA[Initialize Manifold Pressure Setpoints: PIT-001 (10/100 Psi), PIT-002 (200/800/900 Psi), PIT-003 (1700/2700/2800 Psi)]]></Comment>
                <Text><![CDATA[MOV(10.0,SP_PIT001_PAL)MOV(100.0,SP_PIT001_PAH)MOV(200.0,SP_PIT002_PAL)MOV(800.0,SP_PIT002_PAH)MOV(900.0,SP_PIT002_PAHH)MOV(1700.0,SP_PIT003_PAL)MOV(2700.0,SP_PIT003_PAH)MOV(2800.0,SP_PIT003_PAHH);]]></Text>
              </Rung>
              <Rung Number="22" Type="N">
                <Comment><![CDATA[Initialize Tank Level (LIT-100..400) & Flowmeter (6401-FT-001) Setpoints: LAL=0.7m, LAH=9.0/11.0m, FAL=30, FAH=300 bbl/h]]></Comment>
                <Text><![CDATA[MOV(0.7,SP_LIT100_LAL)MOV(9.0,SP_LIT100_LAH)MOV(0.7,SP_LIT200_LAL)MOV(9.0,SP_LIT200_LAH)MOV(0.7,SP_LIT300_LAL)MOV(9.0,SP_LIT300_LAH)MOV(0.7,SP_LIT400_LAL)MOV(11.0,SP_LIT400_LAH)MOV(30.0,SP_FT001_FAL)MOV(300.0,SP_FT001_FAH);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Input" Type="RLL">
            <Description><![CDATA[Hardware Input Mapping from Slots 2, 3, 4, 7 to Internal Image]]></Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Slot 7 Bit 0: 6401-ZSH-001 ESD Valve Open Limit Switch]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.0)[OTE(ZSH_6401_001),OTE(G0001)];]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Slot 7 Bit 1: 6401-ZSL-001 ESD Valve Closed Limit Switch]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.1)[OTE(ZSL_6401_001),OTE(G0002)];]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment><![CDATA[Slot 7 Bit 2: FGCP-7404-001 Panel Stop Foam Button (E8) / SpareDI_08]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.2)[OTE(FS_FGCP_E8),OTE(G0008),OTE(SpareDI_08)];]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment><![CDATA[Slot 7 Bit 3: 7503-LS-002 Diesel Fuel Tank Low Level Switch (NC: 1=OK, 0=Low)]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.3)[OTE(LS_7503_002),OTE(G0005)];]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment><![CDATA[Slot 7 Bit 4: 7503-FS-001 Field Stop Foam Button (NC: 1=OK, 0=Stop)]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.4)[OTE(FS_7503_001),OTE(G0003)];]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment><![CDATA[Slot 7 Bit 5: 7503-LS-001 AFFF Foam Concentrate Tank Low Level Switch (NC: 1=OK, 0=Low)]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.5)[OTE(LS_7503_001),OTE(G0004)];]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment><![CDATA[Slot 7 Bit 6: 75-C-01A Pulsed Line Continuity Feedback for Deluge Pump A]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.6)[OTE(Pump_A_PulsIn),OTE(G0006)];]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment><![CDATA[Slot 7 Bit 7: 75-C-01B Pulsed Line Continuity Feedback for Deluge Pump B]]></Comment>
                <Text><![CDATA[XIC(Local:7:I.Data.7)[OTE(Pump_B_Start_PulsIn),OTE(G0007)];]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
