        <Description><![CDATA[Setpoint: PIT-002 Low Pressure (200.0 Psi)]]></Description>
      </Tag>
      <Tag Name="SP_PIT002_PAH" TagType="Base" DataType="REAL" Constant="false" ExternalAccess="Read/Write">
