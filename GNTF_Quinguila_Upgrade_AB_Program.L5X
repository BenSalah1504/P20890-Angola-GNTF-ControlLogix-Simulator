      <Routine Name="Process_Pressure_Safeguards" Type="RLL">
        <Description><![CDATA[Process Pressure Monitoring & Equipment Safety Interlocks]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Scale PIT-001 Oil Expedition Pressure (0-150 psi)]]></Comment>
            <Text><![CDATA[CPT(PIT_001_OilExped_Scaled,(150.0/32000.0)*Local:3:I.Ch0Data);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[Scale PIT-002 Water Injection Manifold Pressure (0-1000 psi)]]></Comment>
            <Text><![CDATA[CPT(PIT_002_WaterInjMan_Scaled,(1000.0/32000.0)*Local:3:I.Ch1Data);]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Scale PIT-003 Oil Injection Manifold Pressure (0-3500 psi)]]></Comment>
            <Text><![CDATA[CPT(PIT_003_OilInjMan_Scaled,(3500.0/32000.0)*Local:3:I.Ch2Data);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Scale 7503-PST-001 Deluge Discharge Header Pressure (0-150 psi)]]></Comment>
            <Text><![CDATA[CPT(PST_7503_001_Deluge_Scaled,(150.0/32000.0)*Local:3:I.Ch3Data);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
            <Comment><![CDATA[Scale 7002-PST-001 ESDV Air Supply Accumulator Pressure (0-150 psi)]]></Comment>
            <Text><![CDATA[CPT(PST_7002_001_AirAcc_Scaled,(150.0/32000.0)*Local:3:I.Ch4Data);]]></Text>
          </Rung>
          <Rung Number="5" Type="N">
            <Comment><![CDATA[Scale 6401-PST-001 Fuel Gas Line Pressure (0-150 psi)]]></Comment>
            <Text><![CDATA[CPT(PST_6401_001_FuelGas_Scaled,(150.0/32000.0)*Local:3:I.Ch5Data);]]></Text>
          </Rung>
          <Rung Number="6" Type="N">
            <Comment><![CDATA[Oil Injection Manifold High-High Pressure Trip (PAHH >= 2800 psi)]]></Comment>
            <Text><![CDATA[GEQ(PIT_003_OilInjMan_Scaled,SET_OilInj_PAHH_PSI) [ OTE(PIT_003_OilInjMan_HiHiAlm) , OTE(ESD_Power_Oil_Trip) ];]]></Text>
          </Rung>
          <Rung Number="7" Type="N">
            <Comment><![CDATA[Water Injection Manifold High-High Pressure Trip (PAHH >= 800 psi)]]></Comment>
            <Text><![CDATA[GEQ(PIT_002_WaterInjMan_Scaled,SET_WaterInj_PAHH_PSI) [ OTE(PIT_002_WaterInjMan_HiHiAlm) , OTE(ESD_Water_Inj_Trip) ];]]></Text>
          </Rung>
          <Rung Number="8" Type="N">
            <Comment><![CDATA[Fuel Gas Line High Pressure Trip (PAH >= 100 psi)]]></Comment>
            <Text><![CDATA[GEQ(PST_6401_001_FuelGas_Scaled,SET_FuelGas_PAH_PSI) [ OTE(PST_6401_001_FuelGas_HighAlm) , OTE(ESD_Matrix_Master_Trip) ];]]></Text>
          </Rung>
          <Rung Number="9" Type="N">
            <Comment><![CDATA[Fuel Gas Line Low Pressure Alarm (PAL <= 40 psi) -> PCR Amber LED L17]]></Comment>
            <Text><![CDATA[LEQ(PST_6401_001_FuelGas_Scaled,SET_FuelGas_PAL_PSI) [ OTE(PST_6401_001_FuelGas_LowAlm) , OTE(LED_L17_LowFuelGas) ];]]></Text>
          </Rung>
          <Rung Number="10" Type="N">
            <Comment><![CDATA[ESDV Low Air Accumulator Supply (<= 50 psi) -> PCR Amber LED L16]]></Comment>
            <Text><![CDATA[LEQ(PST_7002_001_AirAcc_Scaled,SET_AirAcc_Low_PSI) [ OTE(PST_7002_001_AirAcc_LowAlm) , OTE(LED_L16_LowAirAcc) ];]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
      <Routine Name="Process_Tank_Levels" Type="RLL">
        <Description><![CDATA[Crude Storage Radar Levels & Firewater Auxiliary Tank Monitoring]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Scale LIT-100 Tank T-100 Radar Level (0-14 m)]]></Comment>
            <Text><![CDATA[CPT(LIT_100_Tank_Scaled,(14.0/32000.0)*Local:6:I.Ch0Data);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[Scale LIT-200 Tank T-200 Radar Level (0-14 m)]]></Comment>
            <Text><![CDATA[CPT(LIT_200_Tank_Scaled,(14.0/32000.0)*Local:6:I.Ch1Data);]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Scale LIT-300 Tank T-300 Radar Level (0-14 m)]]></Comment>
            <Text><![CDATA[CPT(LIT_300_Tank_Scaled,(14.0/32000.0)*Local:6:I.Ch2Data);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Scale LIT-400 Tank T-400 Radar Level (0-14 m)]]></Comment>
            <Text><![CDATA[CPT(LIT_400_Tank_Scaled,(14.0/32000.0)*Local:6:I.Ch3Data);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
            <Comment><![CDATA[T-100 Low Level (<= 0.7m) & High Level (>= 9.0m) Alarms]]></Comment>
            <Text><![CDATA[[ LEQ(LIT_100_Tank_Scaled,SET_Tank_LAL_Meters) OTE(LIT_100_Tank_LowAlm) , GEQ(LIT_100_Tank_Scaled,SET_Tank_LAH_Meters) OTE(LIT_100_Tank_HighAlm) ];]]></Text>
          </Rung>
          <Rung Number="5" Type="N">
            <Comment><![CDATA[AFFF Foam Concentrate Tank Low Level Switch (7503-LS-001)]]></Comment>
            <Text><![CDATA[XIC(LS_7503_001_FoamTank) OTE(HORN_PCR_Z1);]]></Text>
          </Rung>
          <Rung Number="6" Type="N">
            <Comment><![CDATA[Deluge Diesel Fuel Tank Low Level Switch (7503-LS-002)]]></Comment>
            <Text><![CDATA[XIC(LS_7503_002_DieselTank) OTE(HORN_PCR_Z1);]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
      <Routine Name="Deluge_Firewater_Control" Type="RLL">
        <Description><![CDATA[Deluge Firewater Pump Auto-Start, 30s Transition & Line Supervision]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Periodic 60s Timer for Deluge Trip Coil Continuity Line Check]]></Comment>
            <Text><![CDATA[XIO(TMR_Deluge_Pulse_Width.DN) TON(TMR_Deluge_Pulse_Period,?,?);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[1.0s Pulse Output for Deluge Solenoid Integrity Supervision]]></Comment>
            <Text><![CDATA[XIC(TMR_Deluge_Pulse_Period.DN) [ TON(TMR_Deluge_Pulse_Width,?,?) , OTE(DO_7503_PumpA_Pulse) , OTE(DO_7503_PumpB_Pulse) ];]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Deluge Firewater Demand Initiation (Fire, Foam Pushbutton, 2ooN Gas, or Header Low Pressure)]]></Comment>
            <Text><![CDATA[[ XIC(VOTE_Any_Confirmed_Fire) , XIC(VOTE_Any_Confirmed_Gas) , XIC(FR_7503_003_LocalCP_Scaled) , XIC(FR_7503_001_002_Field_Scaled) , XIC(PSLL_7404_001_LoPress) ] XIO(KEY_S2_FoamInhibit) XIO(FS_7503_001_FoamStop) OTE(VOTE_Deluge_Demand);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Command Duty Electric Pump A Run Output]]></Comment>
            <Text><![CDATA[XIC(VOTE_Deluge_Demand) OTE(DO_7503_PumpA_Cmd);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
            <Comment><![CDATA[Duty Pump A Pressure Proving & 30-Second Fail-to-Run Timer]]></Comment>
            <Text><![CDATA[XIC(DO_7503_PumpA_Cmd) XIO(PUMP_A_Run_Feedback) TON(TMR_PumpA_FailToRun,?,?);]]></Text>
          </Rung>
          <Rung Number="5" Type="N">
            <Comment><![CDATA[Initiate Standby Diesel Pump B Crank Cycle on Pump A Failure]]></Comment>
            <Text><![CDATA[XIC(TMR_PumpA_FailToRun.DN) XIO(SB_75_01B_PumpBInhKey) XIO(PUMP_B_Run_Feedback) [ OTE(DO_7503_PumpB_Start) , TON(TMR_PumpB_StartCrank,?,?) ];]]></Text>
          </Rung>
          <Rung Number="6" Type="N">
            <Comment><![CDATA[Reset Deluge Demand on Foam Stop Pushbutton Press]]></Comment>
            <Text><![CDATA[XIC(FS_7503_001_FoamStop) [ OTU(VOTE_Deluge_Demand) , OTE(DO_7503_PumpB_Stop) ];]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
      <Routine Name="ESD_Cause_Effect_Matrix" Type="RLL">
        <Description><![CDATA[Cause & Effect Matrix Implementation (Fail-Safe De-energize to Trip)]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Master Plant Emergency Shutdown Demand Initiation (PB-E9, Flame, 2ooN Gas, High Fuel Gas)]]></Comment>
            <Text><![CDATA[[ XIC(PB_E9_ESD_FuelGas) , XIC(VOTE_Any_Confirmed_Fire) , XIC(VOTE_Any_Confirmed_Gas) , XIC(PST_6401_001_FuelGas_HighAlm) ] XIO(KEY_S3_AllOutputsInhibit) OTE(ESD_Matrix_Master_Trip);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[Master Pump Shutdown Relay (Fail-Safe 1=Run, De-energize to Trip)]]></Comment>
            <Text><![CDATA[XIO(ESD_Matrix_Master_Trip) OTE(ESD_TRIP_Master);]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Fuel Gas ESDV Solenoid (Fail-Safe 1=Open, De-energize to Slam Shut)]]></Comment>
            <Text><![CDATA[XIO(ESD_Matrix_Master_Trip) OTE(EY_6401_001_002);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Power Oil Booster Pumps P-2100 / P-2200 Trip Relay (Fail-Safe 1=Run)]]></Comment>
            <Text><![CDATA[[ XIO(ESD_Matrix_Master_Trip) XIO(ESD_Power_Oil_Trip) XIO(PB_E1_E4_PowerOilStop) ] OTE(EDB1_OilBoosterStop);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
            <Comment><![CDATA[Water Injection Booster Pumps P-3600 / P-3700 Trip Relay (Fail-Safe 1=Run)]]></Comment>
            <Text><![CDATA[[ XIO(ESD_Matrix_Master_Trip) XIO(ESD_Water_Inj_Trip) XIO(PB_E5_E6_WaterInjStop) ] OTE(EDB1_WaterBoosterStop);]]></Text>
          </Rung>
          <Rung Number="5" Type="N">
            <Comment><![CDATA[Emergency Trip of All Gas Turbine Generators (Fail-Safe De-energize to Trip)]]></Comment>
            <Text><![CDATA[XIC(ESD_Gas_Turbine_Trip) OTE(SD_GE_GasGenTrip);]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
      <Routine Name="Inhibit_Maintenance" Type="RLL">
        <Description><![CDATA[Maintenance Bypass Keyswitches S2 & S3 Interlock Supervision]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Deluge Foam Release Inhibit Active (Keyswitch S2 Turned to Position I)]]></Comment>
