    <Routines>
      <Routine Name="Main_Scheduler" Type="RLL">
        <Description><![CDATA[Executive Cycle Scheduler & Subroutine Dispatch]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Rung 0: 400ms Free-Running Slow Flasher (Annunciator Flash)]]></Comment>
            <Text><![CDATA[XIO(TMR_Flash_Fast.DN) TON(TMR_Flash_Slow,?,?);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[Rung 1: 200ms Free-Running Fast Flasher (High-High Strobe)]]></Comment>
            <Text><![CDATA[XIC(TMR_Flash_Slow.DN) TON(TMR_Flash_Fast,?,?);]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Rung 2: First Scan Initialization Subroutine Trigger]]></Comment>
            <Text><![CDATA[XIC(S:FS) JSR(Init_Setpoints,0);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Rung 3: Execute Hardware Input Acquisition Routine]]></Comment>
            <Text><![CDATA[JSR(IO_Input_Acquisition,0);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
            <Comment><![CDATA[Rung 4: Execute Combustible CH4 Gas Detection Processing]]></Comment>
            <Text><![CDATA[JSR(FAG_Combustible_CH4,0);]]></Text>
          </Rung>
          <Rung Number="5" Type="N">
            <Comment><![CDATA[Rung 5: Execute Toxic H2S Gas Detection Processing]]></Comment>
            <Text><![CDATA[JSR(FAG_Toxic_H2S,0);]]></Text>
          </Rung>
          <Rung Number="6" Type="N">
            <Comment><![CDATA[Rung 6: Execute Optical Flame Detection Processing]]></Comment>
            <Text><![CDATA[JSR(FAG_Optical_Flame,0);]]></Text>
          </Rung>
          <Rung Number="7" Type="N">
            <Comment><![CDATA[Rung 7: Execute Smoke Detection Processing]]></Comment>
            <Text><![CDATA[JSR(FAG_Smoke_Detection,0);]]></Text>
          </Rung>
          <Rung Number="8" Type="N">
            <Comment><![CDATA[Rung 8: Execute Multi-Zone 2ooN Voting Logic]]></Comment>
            <Text><![CDATA[JSR(Voting_2ooN_Coincidence,0);]]></Text>
          </Rung>
          <Rung Number="9" Type="N">
            <Comment><![CDATA[Rung 9: Execute Process Pressure Monitoring & Safeguards]]></Comment>
            <Text><![CDATA[JSR(Process_Pressure_Safeguards,0);]]></Text>
          </Rung>
          <Rung Number="10" Type="N">
            <Comment><![CDATA[Rung 10: Execute Crude Storage Tank Radar Levels Processing]]></Comment>
            <Text><![CDATA[JSR(Process_Tank_Levels,0);]]></Text>
          </Rung>
          <Rung Number="11" Type="N">
            <Comment><![CDATA[Rung 11: Execute Deluge & Firewater Skid Sequencing]]></Comment>
            <Text><![CDATA[JSR(Deluge_Firewater_Control,0);]]></Text>
          </Rung>
          <Rung Number="12" Type="N">
            <Comment><![CDATA[Rung 12: Execute Master Cause & Effect Matrix Shutdown Cascades]]></Comment>
            <Text><![CDATA[JSR(ESD_Cause_Effect_Matrix,0);]]></Text>
          </Rung>
          <Rung Number="13" Type="N">
            <Comment><![CDATA[Rung 13: Execute Maintenance Bypass & Keyswitch Interlocks]]></Comment>
            <Text><![CDATA[JSR(Inhibit_Maintenance,0);]]></Text>
          </Rung>
          <Rung Number="14" Type="N">
            <Comment><![CDATA[Rung 14: Execute PCR Annunciator Panel & Horn Sounder Drivers]]></Comment>
            <Text><![CDATA[JSR(Annunciation_PCR_Panel,0);]]></Text>
          </Rung>
          <Rung Number="15" Type="N">
            <Comment><![CDATA[Rung 15: Execute Hardware Output Image Dispatch]]></Comment>
            <Text><![CDATA[JSR(IO_Output_Dispatch,0);]]></Text>
          </Rung>
          <Rung Number="16" Type="N">
            <Comment><![CDATA[Rung 16: Maintain Controller Watchdog Healthy Flag]]></Comment>
            <Text><![CDATA[XIO(COMMON_SYSTEM_FAULT) OTE(SYS_Watchdog_OK);]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
      <Routine Name="Init_Setpoints" Type="RLL">
        <Description><![CDATA[Calibrated Engineering Ranges & Trip Setpoint Initialization]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Rung 0: Combustible Gas Alarm Trip Limits (20% Low, 30% High-High LEL)]]></Comment>
            <Text><![CDATA[MOV(20.0,SET_CH4_LowAlm_LEL) MOV(30.0,SET_CH4_HiHiAlm_LEL);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[Rung 1: Toxic H2S Alarm Trip Limits (10 ppm Low, 20 ppm High-High)]]></Comment>
            <Text><![CDATA[MOV(10.0,SET_H2S_LowAlm_PPM) MOV(20.0,SET_H2S_HiHiAlm_PPM);]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Rung 2: Oil Injection Manifold Limits (PAL 1700, PAH 2700, PAHH 2800 psi)]]></Comment>
            <Text><![CDATA[MOV(1700.0,SET_OilInj_PAL_PSI) MOV(2700.0,SET_OilInj_PAH_PSI) MOV(2800.0,SET_OilInj_PAHH_PSI);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Rung 3: Water Injection Manifold Limits (PAL 200, PAH 800, PAHH 800 psi)]]></Comment>
            <Text><![CDATA[MOV(200.0,SET_WaterInj_PAL_PSI) MOV(800.0,SET_WaterInj_PAH_PSI) MOV(800.0,SET_WaterInj_PAHH_PSI);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
            <Comment><![CDATA[Rung 4: Fuel Gas Line Pressure Limits (PAL 40, PAH 100 psi)]]></Comment>
            <Text><![CDATA[MOV(40.0,SET_FuelGas_PAL_PSI) MOV(100.0,SET_FuelGas_PAH_PSI);]]></Text>
          </Rung>
          <Rung Number="5" Type="N">
            <Comment><![CDATA[Rung 5: ESDV Air Accumulator Minimum Pressure Limit (50 psi)]]></Comment>
            <Text><![CDATA[MOV(50.0,SET_AirAcc_Low_PSI);]]></Text>
          </Rung>
          <Rung Number="6" Type="N">
            <Comment><![CDATA[Rung 6: Oil Expedition Line Limits (PAL 10, PAH 100 psi)]]></Comment>
            <Text><![CDATA[MOV(10.0,SET_OilExped_PAL_PSI) MOV(100.0,SET_OilExped_PAH_PSI);]]></Text>
          </Rung>
          <Rung Number="7" Type="N">
            <Comment><![CDATA[Rung 7: Crude Storage Tank Radar Levels (LAL 0.7m, LAH 9.0m/11.0m)]]></Comment>
            <Text><![CDATA[MOV(0.7,SET_Tank_LAL_Meters) MOV(9.0,SET_Tank_LAH_Meters);]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
