        <Description><![CDATA[Triple-IR Optical Flame Detection (Immediate Deluge & ESD Trigger)]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[7404-DF-001 Triple-IR Optical Flame Detector Trip Evaluation]]></Comment>
            <Text><![CDATA[GRT(Local:4:I.Ch11Data,16000) OTE(DF_7404_001_FireAlarm);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[7404-DF-002 Triple-IR Optical Flame Detector Trip Evaluation]]></Comment>
            <Text><![CDATA[GRT(Local:4:I.Ch12Data,16000) OTE(DF_7404_002_FireAlarm);]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[7404-DF-003 Triple-IR Optical Flame Detector Trip Evaluation]]></Comment>
            <Text><![CDATA[GRT(Local:4:I.Ch13Data,16000) OTE(DF_7404_003_FireAlarm);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Global Confirmed Optical Fire Alarm Latch]]></Comment>
            <Text><![CDATA[[ XIC(DF_7404_001_FireAlarm) , XIC(DF_7404_002_FireAlarm) , XIC(DF_7404_003_FireAlarm) ] OTE(VOTE_Any_Confirmed_Fire);]]></Text>
          </Rung>
        </RLLContent>
      </Routine>
      <Routine Name="FAG_Smoke_Detection" Type="RLL">
