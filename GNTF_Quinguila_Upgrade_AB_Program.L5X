          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[Zone 3 (Tank Farm) 2ooN Gas Voting (DG-007 .. 010)]]></Comment>
            <Text><![CDATA[[ [ XIC(DG_7404_007_HiHiAlm) XIC(DG_7404_008_HiHiAlm) ] , [ XIC(DG_7404_008_HiHiAlm) XIC(DG_7404_009_HiHiAlm) ] , [ XIC(DG_7404_009_HiHiAlm) XIC(DG_7404_010_HiHiAlm) ] ] OTE(VOTE_Zone3_Gas_Confirmed);]]></Text>
          </Rung>
          <Rung Number="3" Type="N">
            <Comment><![CDATA[Zone 4 (Generator Room) 2ooN Gas Voting (DG-011 .. 013)]]></Comment>
            <Text><![CDATA[[ [ XIC(DG_7404_011_HiHiAlm) XIC(DG_7404_012_HiHiAlm) ] , [ XIC(DG_7404_012_HiHiAlm) XIC(DG_7404_013_HiHiAlm) ] ] OTE(VOTE_Zone4_Gas_Confirmed);]]></Text>
          </Rung>
          <Rung Number="4" Type="N">
