      <Routine Name="FAG_Combustible_CH4" Type="RLL">
        <Description><![CDATA[24 Combustible CH4 Gas Detectors Scaling, Diagnostics & Alarms]]></Description>
        <RLLContent>
          <Rung Number="0" Type="N">
            <Comment><![CDATA[Scale 7404-DG-001 Raw Counts to 0-100% LEL]]></Comment>
            <Text><![CDATA[CPT(DG_7404_001_Scaled,(100.0/32000.0)*Local:2:I.Ch0Data);]]></Text>
          </Rung>
          <Rung Number="1" Type="N">
            <Comment><![CDATA[7404-DG-001 Low Alarm (>= 20% LEL) & High-High (>= 30% LEL)]]></Comment>
            <Text><![CDATA[[ GEQ(DG_7404_001_Scaled,SET_CH4_LowAlm_LEL) OTE(DG_7404_001_LowAlm) , GEQ(DG_7404_001_Scaled,SET_CH4_HiHiAlm_LEL) OTE(DG_7404_001_HiHiAlm) ];]]></Text>
          </Rung>
          <Rung Number="2" Type="N">
            <Comment><![CDATA[7404-DG-001 Sensor Faults (Underrange < -4% or Overrange > 105%)]]></Comment>
            <Text><![CDATA[[ LES(DG_7404_001_Scaled,-4.0) OTE(DG_7404_001_Flt_Low) , GRT(DG_7404_001_Scaled,105.0) OTE(DG_7404_001_Flt_High) ];]]></Text>
